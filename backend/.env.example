# ================================
# CONFIGURACIÓN DE ENTORNO - BACKEND
# ================================

# Entorno de ejecución
NODE_ENV=development

# Puerto del servidor
PORT=3000

# Base de Datos
DATABASE_URL=postgresql://postgres:Noname20@localhost:5432/semillero_iot?schema=public


# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:3001

# Rate Limiting (requests por ventana de tiempo)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Archivos subidos
MAX_FILE_SIZE_MB=5
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/avif

# URLs externas
FRONTEND_URL=http://localhost:5173

# Monitoreo y observabilidad
ENABLE_METRICS=true
CORRELATION_ID_HEADER=x-correlation-id

# Modo mantenimiento
MAINTENANCE_MODE=false
